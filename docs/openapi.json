    "/v1/internal/sources/{id}/refresh": {
      "post": {
        "summary": "Bounded authenticated ingestion with request-bound idempotency",
        "responses": {
          "200": {
            "description": "Successful bounded response"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not public or absent"
          },
          "429": {
            "description": "Rate/budget limit"
          },
          "503": {
            "description": "Temporarily unavailable"
          }
        },
        "security": [
          {
            "sourceServiceBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "cursor": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "identifiers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 5,
                    "items": {
                      "type": "string",
                      "maxLength": 120
                    }
                  },
                  "idempotency_key": {
                    "type": "string",
                    "maxLength": 180
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/internal/source-cron": {
      "post": {
        "summary": "Internal genuine Neon schedule delivery only; not bearer or client callable",
        "responses": {
          "200": {
            "description": "Successful bounded response"
          },
          "400": {
