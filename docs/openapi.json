    "/v1/search": {
      "get": {
        "summary": "Search sampled metadata index; not exhaustive upstream search",
        "responses": {
          "200": {
            "description": "Successful bounded response"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not public or absent"
          },
          "429": {
            "description": "Rate/budget limit"
          },
          "503": {
            "description": "Temporarily unavailable"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            }
          },
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en",
                "la"
              ],
              "default": "ar"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 25
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 1
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ingredient",
                "precise_ingredient",
                "clinical_drug",
                "product",
                "chemical_compound",
                "research",
                "disease_topic",
                "anatomy_term"
              ]
            }
          }
        ]
      }
    },
